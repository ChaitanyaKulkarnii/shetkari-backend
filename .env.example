# Environment Configuration for Sangli Soybean Advisory Backend

# Port and Host
HOST=0.0.0.0
PORT=8000

# Admin API Key for protected operations (e.g., retrain harvest model)
# CHANGE THIS in production!
ADMIN_API_KEY=changeme-set-a-real-key

# Allowed CORS Origins (comma-separated; set specific origins in production)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# File Paths
MODEL_PATH=model/soy_advisor.pkl
FEEDBACK_DATA_PATH=data/harvest_feedback.csv

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
